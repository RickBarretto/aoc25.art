#! arturo

; ======================
;      NEW COMMAND
; ======================

challengeReadme: $[day :integer][
  ~{
    ## Day |day|

    [Challenge Description](https://adventofcode.com/2025/day/|day|).
  }
]

challengeFile: {:

runChallenge: $[content :string][
    print "Implement your solution...\n"
    print "Content:"
    print content
]

:}

mainFile: {:
#! arturo

import ./"challenge"!

ensure.that: "Missing argument: <file>. Allowed: 'sample' | 'full'"
   -> not? throws? -> arg\0
ensure.that: "Invalid argument: <file>. Allowed: 'sample' | 'full'"
   [in? arg\0 ["sample" "full"]]


content: read ./~"|arg\0|.txt"
runChallenge content

:}

challengeText: $[day :integer][
  url: ~"https://adventofcode.com/2025/day/|day|"
  read.html url | get 'body | get 'main | get 'article | get 'text
    | replace ".\n" ".\n\n"
    | replace ":\n" ":\n\n"
]

newChallenge: $[day :integer][
  name: ~"day-|day|"

  if exists? name [
    panic "Error: Challenge already exists"
  ]

  write.directory null name

  write mainFile ~"|name|/main.art"
  write challengeFile ~"|name|/challenge.art"

  write challengeReadme day ~"|name|/README.md"

  write "" ~"|name|/sample.txt"
  write "" ~"|name|/full.txt"
]

handleNew: $[][
  ensure.that: "Missing argument: <day>" -> not? throws? -> arg\1
  (try [day: <= to :integer arg\1])?
    -> panic "Invalid argument: <day> must be an :integer"
    -> newChallenge day
]


; ======================
;  RUN & TEST COMMANDS
; ======================

executeChallenge: $[day :integer kind :literal][
  ensure -> in? kind ['sample 'full]
  dir: ~"day-|day|"
  execute.directly ~"arturo ./|dir|/main.art |kind|"
]

handleTest: $[][
  ensure.that: "Missing argument: <day>" -> not? throws? -> arg\1
  (try [day: <= to :integer arg\1])?
    -> panic "Invalid argument: <day> must be an :integer"
    -> executeChallenge day 'sample
]

handleRun: $[][
  ensure.that: "Missing argument: <day>" -> not? throws? -> arg\1
  (try [day: <= to :integer arg\1])?
    -> panic "Invalid argument: <day> must be an :integer"
    -> executeChallenge day 'full
]


; ======================
;    HELPER COMMANDS
; ======================

handleDescription: $[][
  ensure.that: "Missing argument: <day>" -> not? throws? -> arg\1
  (try [day: <= to :integer arg\1])?
    -> panic "Invalid argument: <day> must be an :integer"
    -> print challengeText day
]

handleSolution: $[][
  ensure.that: "Missing argument: <day>" -> not? throws? -> arg\1
  (try [day: <= to :integer arg\1])?
    -> panic "Invalid argument: <day> must be an :integer"
    -> print read ./~"day-|day|/challenge.art"
]

help: $[][
  print "Usage: arturo aoc.art [command]"
  print "Commands:"
  print "  help"
  print "  new <day>"
  print "  run <day>"
  print "  test <day>"
  print "  description <day>"
  print "  solution <day>"
  print ""
  print "Examples:"
  print "  arturo aoc.art new 1"
  print "  arturo aoc.art run 1"
]

main: $[][
  ensure.that: "Missing command" -> not? empty? arg
  command: arg\0

  case command [
    "help" -> help
    "new" -> handleNew
    "run" -> handleRun
    "test" -> handleTest
    "description" -> handleDescription
    "solution" -> handleSolution
    any -> print "Unknown command"
  ]
]

main
